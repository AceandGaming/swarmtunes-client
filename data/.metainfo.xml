<?xml version="1.0" encoding="UTF-8"?>

<component type="desktop-application">
    <id>com.swarmtunes.Swarmtunes</id>

    <name>Swarmtunes</name>
    <summary>A Neuro-sama music app</summary>

    <url type="homepage">https://swarmtunes.com/</url>
    <url type="vcs-browser">https://github.com/AceandGaming/swarmtunes-client</url>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>
    <content_rating type="oars-1.1">
        <content_attribute id="language-profanity">mild</content_attribute>
    </content_rating>

    <developer id="com.swarmtunes">
        <name>Ace and Gaming</name>
    </developer>

    <description>
        <p>
            Swarmtunes is a music app for all Neuro and Evil covers of songs, as well as official releases and collaborations. It features accounts, playlists, and songs grouped by streamer. 
        </p>
        <p>
            Swarmtunes is a fan-made app and is not associated with Vedal, Neuro-sama, or SwarmFM.
        </p>
    </description>

    <launchable type="desktop-id">
        com.swarmtunes.Swarmtunes.desktop
    </launchable>

    <screenshots>
        <screenshot type="default">
            <image>https://swarmtunes.com/screenshots/main.png</image>
            <caption>Swarmtunes Home page</caption>
        </screenshot>
        <screenshot>
            <image>https://swarmtunes.com/screenshots/1.png</image>
            <caption>The song Colorful Array in Fullscreen</caption>
        </screenshot>
    </screenshots>

    <releases>
        <release version="0.1.0" date="2026-09-13" />
    </releases>
</component>