{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "swarmtunes-client",
  "version": "0.0.0",
  "identifier": "com.swarmtunes.Swarmtunes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Swarmtunes",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCRUIyNzcxOUE0OUY1MjAKUldRZzlVbWFjU2ZyMnphZUw3Q0tlVEJGaWtDelB2b0R3T1VNSFdTY29rQ3ZLcXI1a3ZERWFiNEQK",
      "endpoints": [
        "https://github.com/AceandGaming/swarmtunes-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}